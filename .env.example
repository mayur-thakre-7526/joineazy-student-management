# -----------------------------------------------------------------------------
# Joineazy - Student, Group & Assignment Management System
# Root Environment Configuration Template
# Copy to .env for local Docker Compose or standalone development
# -----------------------------------------------------------------------------

# Environment Mode: development | production | test
NODE_ENV=development

# Backend Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=joineazy_db
DB_USER=joineazy_user
DB_PASSWORD=joineazy_password
DATABASE_URL=postgres://joineazy_user:joineazy_password@localhost:5432/joineazy_db

# Frontend Configuration (exposed to Vite)
VITE_API_URL=http://localhost:5000/api
