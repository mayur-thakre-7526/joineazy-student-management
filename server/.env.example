# -----------------------------------------------------------------------------
# Joineazy Backend Server Environment Template
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=joineazy_db
DB_USER=joineazy_user
DB_PASSWORD=joineazy_password
DATABASE_URL=postgres://joineazy_user:joineazy_password@localhost:5432/joineazy_db

# PostgreSQL SSL
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication & JWT Configuration
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Admin Provisioning (Used by npm run seed:admin)
ADMIN_EMAIL=admin@joineazy.edu
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_min_12_chars
ADMIN_NAME=System Administrator
